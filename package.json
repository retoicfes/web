{
  "name": "ynex",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm sass && next dev --webpack",
    "build": "pnpm sass && next build",
    "start": "next start",
    "lint": "eslint .",
    "postcss": "sass ./public/assets/scss/style.scss ./public/assets/css/style.css && postcss ./public/assets/css/style.css -o ./public/assets/css/style.css",
    "sass": "sass ./public/assets/scss/:./public/assets/css/",
    "sass-min": "sass ./public/assets/scss/:./public/assets/css/ --style compressed"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@simonwep/pickr": "^1.9.1",
    "@tsparticles/engine": "4.0.2",
    "@tsparticles/react": "4.0.2",
    "@tsparticles/slim": "4.0.2",
    "apexcharts": "^5.12.0",
    "firebase": "^12.13.0",
    "next": "16.2.6",
    "postcss-cli": "^11.0.1",
    "preline": "^4.2.0",
    "react": "^19.2.6",
    "react-apexcharts": "^2.1.0",
    "react-dom": "^19.2.6",
    "react-perfect-scrollbar": "^1.5.8",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "sass": "^1.99.0",
    "simplebar-react": "^3.3.2"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ],
    "packageExtensions": {
      "@tsparticles/react@4.0.2": {
        "peerDependencies": {
          "@tsparticles/engine": "4.0.2"
        }
      }
    }
  }
}
