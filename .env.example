# Copia a .env.local (Next.js + Prisma leen este archivo vía prisma/load-env.ts)
#
# En Vercel: proyecto → Storage → Postgres → pestaña .env.local
# Suele venir como:
#   POSTGRES_PRISMA_URL      → conexión con pool (app en runtime)
#   POSTGRES_URL_NON_POOLING → sin pool (migraciones / db push)

# Neon (Vercel Storage) — copia SOLO las de tu dashboard, sin duplicar DATABASE_URL
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# SEO y analytics (solo Production en Vercel — no marcar Preview)
NEXT_PUBLIC_SITE_URL=https://retoicfes.com
NEXT_PUBLIC_GTM_ID=GTM-WS9J3TRR
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-53L2DLHYFF
# Meta Pixel (retoicfespixel)
NEXT_PUBLIC_META_PIXEL_ID=3157959171071642

# Opcional (load-env.ts las mapea a DATABASE_URL / DIRECT_URL para Prisma)
# DATABASE_URL=""
# DIRECT_URL=""

# Obligatorio en producción y preview: firma tokens de ronda y ranking (openssl rand -hex 32)
ROUND_SIGNING_SECRET=""

# Admin local / carga de preguntas (openssl rand -hex 24). En dev sin valor = acceso libre.
ADMIN_SECRET=""
