# Copia a .env.local (Next.js + Prisma leen este archivo vía prisma/load-env.ts)
#
# En Vercel: proyecto → Storage → Postgres → pestaña .env.local
# Suele venir como:
#   POSTGRES_PRISMA_URL      → conexión con pool (app en runtime)
#   POSTGRES_URL_NON_POOLING → sin pool (migraciones / db push)

# Neon (Vercel Storage) — copia SOLO las de tu dashboard, sin duplicar DATABASE_URL
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# SEO y analytics (producción)
NEXT_PUBLIC_SITE_URL=https://retoicfes.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Opcional (load-env.ts las mapea a DATABASE_URL / DIRECT_URL para Prisma)
# DATABASE_URL=""
# DIRECT_URL=""
